# Shia App Factory shared VPS reverse proxy template.
# Canonical domain: shiaco.com
# Activate each hostname only after its DNS record points to the production VPS.
# Keep app services bound to localhost or a private Docker network after proxy cutover.

# Optional ACME contact email can be added in a global block once confirmed:
# {
#     email admin@shiaco.com
# }

marketswarm.shiaco.com {
    encode zstd gzip
    reverse_proxy 127.0.0.1:3010
}

tutor.shiaco.com {
    encode zstd gzip
    reverse_proxy 127.0.0.1:3020
}

michel.shiaco.com {
    encode zstd gzip
    reverse_proxy 127.0.0.1:3030
}

remixr.shiaco.com {
    encode zstd gzip
    reverse_proxy 127.0.0.1:3040
}
