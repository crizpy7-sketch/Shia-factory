# BORIS-001 runtime configuration. Copy to .env and fill in. Never commit a filled-in copy.

# ---------------------------------------------------------------- model provider
# Implemented adapters: anthropic, scripted (test double, gated).
BORIS_PROVIDER=anthropic
BORIS_MODEL=claude-sonnet-5
# Without a key the Anthropic adapter reports itself unavailable and no task can run.
ANTHROPIC_API_KEY=

# The scripted provider is a deterministic TEST DOUBLE. It refuses to load unless this is "true".
# Never set it in production.
BORIS_ALLOW_TEST_PROVIDER=
BORIS_SCRIPT=fixture-repair

# ---------------------------------------------------------------------- server
BORIS_HOST=127.0.0.1
BORIS_PORT=8787
# When a token is set, every route except /api/health requires `Authorization: Bearer <token>`.
BORIS_API_TOKEN=
BORIS_REQUIRE_AUTH=false

# ------------------------------------------------------------ paths and storage
# Repository root; BORIS-001's identity is read from <root>/agents/BORIS-001.
BORIS_REPO_ROOT=
BORIS_DB_PATH=./boris/data/boris.db
# Comma-separated. Every file and command tool is sandboxed to these directories.
BORIS_WORKSPACE_ROOTS=./boris/workspaces
BORIS_IDENTITY_DIR=

# --------------------------------------------------------------------- limits
# Reaching a limit blocks the task for a human decision; it never silently continues.
BORIS_MAX_MODEL_CALLS=40
BORIS_MAX_TURNS=25
BORIS_MAX_WORKERS=4
BORIS_MAX_WORKER_DEPTH=2
BORIS_MAX_TASK_MS=1200000
BORIS_MAX_ATTEMPTS=3
BORIS_MAX_TOOL_CALLS=200
BORIS_MAX_COST_USD=5
BORIS_MAX_OUTPUT_TOKENS=4096
BORIS_SHELL_TIMEOUT_MS=120000
BORIS_MAX_SHELL_OUTPUT=200000
BORIS_MAX_FILE_BYTES=1000000
BORIS_MAX_CONCURRENT_TASKS=2

# ------------------------------------------------------------------ operations
BORIS_LOG_LEVEL=info
BORIS_WORKER_POLL_MS=1000
BORIS_SCHEDULER_POLL_MS=5000
BORIS_AGENT_ID=BORIS-001
