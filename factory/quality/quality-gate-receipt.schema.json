{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shia.factory/schemas/quality-gate-receipt-v1.json",
  "title": "Shia Factory Quality Gate Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "receiptId", "finalState", "taskId", "projectId", "repository", "candidateSha", "branch",
    "riskTier", "taskContract", "acceptanceCriteria", "requiredEvidence", "actualEvidence", "staleEvidence",
    "criterionResults", "gateResults", "knownLimitations", "reworkRequests", "approvalGates", "independentReviewer",
    "controlPlane", "repair", "evaluatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "receiptId": { "$ref": "#/$defs/sha256" },
    "finalState": { "enum": ["pass", "reject", "blocked", "needs-evidence"] },
    "taskId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "minLength": 1 },
    "candidateSha": { "$ref": "#/$defs/candidateSha" },
    "branch": { "type": "string", "minLength": 1 },
    "riskTier": { "$ref": "#/$defs/riskTier" },
    "taskContract": { "type": "object" },
    "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/acceptanceCriterion" } },
    "requiredEvidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "actualEvidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "staleEvidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "criterionResults": { "type": "array", "items": { "$ref": "#/$defs/criterionResult" } },
    "gateResults": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "$ref": "#/$defs/gateResult" } },
    "knownLimitations": { "type": "array", "items": { "type": "string" } },
    "reworkRequests": { "type": "array", "items": { "$ref": "#/$defs/reworkRequest" } },
    "approvalGates": { "type": "array", "items": { "$ref": "#/$defs/approvalGate" } },
    "independentReviewer": {
      "oneOf": [
        { "type": "null" },
        { "type": "object", "additionalProperties": false, "required": ["id", "source", "independent"], "properties": {
          "id": { "type": "string", "minLength": 1 }, "source": { "type": "string", "minLength": 1 }, "independent": { "type": "boolean" }
        } }
      ]
    },
    "controlPlane": {
      "type": "object", "additionalProperties": false,
      "required": ["authority", "qualityGateMayAcceptTask", "gstackMayAcceptTask", "qualityEvidenceGrantsActionAuthority"],
      "properties": {
        "authority": { "const": "shia-core" },
        "qualityGateMayAcceptTask": { "const": false },
        "gstackMayAcceptTask": { "const": false },
        "qualityEvidenceGrantsActionAuthority": { "const": false }
      }
    },
    "repair": {
      "type": "object", "additionalProperties": false, "required": ["attempt", "maxAttempts", "remainingAttempts"],
      "properties": {
        "attempt": { "type": "integer", "minimum": 0 },
        "maxAttempts": { "type": "integer", "minimum": 0, "maximum": 2 },
        "remainingAttempts": { "type": "integer", "minimum": 0, "maximum": 2 }
      }
    },
    "evaluatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "candidateSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "riskTier": { "enum": ["T0", "T1", "T2", "T3", "T4"] },
    "acceptanceCriterion": {
      "type": "object", "additionalProperties": false, "required": ["id", "statement", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "statement": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false, "required": ["id", "severity", "summary", "criterionIds", "evidenceIds"],
      "properties": {
        "id": { "type": "string" }, "severity": { "enum": ["P0", "P1", "P2", "P3"] }, "summary": { "type": "string" },
        "criterionIds": { "type": "array", "items": { "type": "string" } }, "evidenceIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evidence": {
      "type": "object", "required": ["id", "kind", "candidateSha", "status", "source", "summary", "criterionIds", "observedAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["typecheck", "lint", "unit", "integration", "e2e", "browser", "visual", "accessibility", "security", "adversarial", "performance", "permission", "independent-review", "human-approval", "artifact"] },
        "candidateSha": { "$ref": "#/$defs/candidateSha" }, "status": { "enum": ["pass", "fail", "unavailable"] },
        "source": { "type": "string", "minLength": 1 }, "summary": { "type": "string", "minLength": 1 },
        "criterionIds": { "type": "array", "items": { "type": "string" } }, "observedAt": { "type": "string", "format": "date-time" },
        "method": { "enum": ["automated-tool", "real-browser", "source-inspection", "manual-observation", "gstack-workflow"] },
        "testedSurfaces": { "type": "array", "items": { "type": "string" } }, "untestedSurfaces": { "type": "array", "items": { "type": "string" } },
        "browser": { "type": "object" }, "artifact": { "type": "object" },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "thresholds": { "type": "array", "items": { "type": "object" } }, "measurements": { "type": "array", "items": { "type": "object" } }
      }
    },
    "criterionResult": {
      "type": "object", "additionalProperties": false, "required": ["id", "statement", "state", "requiredEvidence", "evidenceIds", "failures"],
      "properties": {
        "id": { "type": "string" }, "statement": { "type": "string" }, "state": { "enum": ["pass", "fail", "needs-evidence"] },
        "requiredEvidence": { "type": "array", "items": { "type": "string" } }, "evidenceIds": { "type": "array", "items": { "type": "string" } },
        "failures": { "type": "array", "items": { "$ref": "#/$defs/finding" } }
      }
    },
    "gateResult": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "applicable", "state", "mode", "requiredEvidenceKinds", "evidenceIds", "findings", "untestedSurfaces", "limitations"],
      "properties": {
        "id": { "enum": ["automated-checks", "browser-visual", "accessibility", "security-adversarial", "performance", "dangerous-action-permission"] },
        "applicable": { "type": "boolean" }, "state": { "enum": ["pass", "fail", "blocked", "needs-evidence", "not-applicable"] }, "mode": { "type": "string" },
        "requiredEvidenceKinds": { "type": "array", "items": { "type": "string" } }, "evidenceIds": { "type": "array", "items": { "type": "string" } },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } }, "untestedSurfaces": { "type": "array", "items": { "type": "string" } },
        "limitations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "reworkRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["owner", "candidateSha", "failedCriterionId", "reason", "evidenceIds", "repairAttempt", "remainingAttempts", "newCandidateRequired"],
      "properties": {
        "owner": { "const": "boris" }, "candidateSha": { "$ref": "#/$defs/candidateSha" }, "failedCriterionId": { "type": "string" },
        "reason": { "type": "string" }, "evidenceIds": { "type": "array", "items": { "type": "string" } },
        "repairAttempt": { "type": "integer", "minimum": 1 }, "remainingAttempts": { "type": "integer", "minimum": 0, "maximum": 2 },
        "newCandidateRequired": { "const": true }
      }
    },
    "approvalGate": {
      "type": "object", "additionalProperties": false, "required": ["name", "state", "evidenceId"],
      "properties": {
        "name": { "type": "string" }, "state": { "enum": ["satisfied", "pending", "denied"] },
        "evidenceId": { "type": ["string", "null"] }
      }
    }
  }
}
