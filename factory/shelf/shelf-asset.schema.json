{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shia.factory/schemas/shelf-asset-v1.json",
  "title": "Shia Factory Shelf asset v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assetId", "type", "lifecycle", "version", "owner", "purpose", "repository", "capabilities", "capabilityAliases", "dependencies", "supportedPlatforms", "interfaces", "blueprint", "compatibility", "provenance", "exactSource", "qualityGate", "security", "documentation", "examples", "tests", "knownLimitations", "maintenance", "deprecation"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "assetId": { "type": "string", "pattern": "^(block|module|blueprint):[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "type": { "enum": ["block", "module", "blueprint"] },
    "lifecycle": { "enum": ["candidate", "admitted", "deprecated", "revoked"] },
    "version": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$" },
    "owner": { "enum": ["shia-core", "boris", "design-director", "gary", "quality-gate"] },
    "purpose": { "type": "string", "minLength": 1 },
    "repository": { "$ref": "#/$defs/repository" },
    "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } },
    "capabilityAliases": { "type": "object", "additionalProperties": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } },
    "dependencies": { "type": "array", "items": { "$ref": "#/$defs/dependency" }, "uniqueItems": true },
    "supportedPlatforms": { "$ref": "#/$defs/nonEmptyStrings" },
    "interfaces": { "type": "array", "items": { "$ref": "#/$defs/interface" } },
    "blueprint": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/blueprint" }] },
    "compatibility": { "$ref": "#/$defs/compatibility" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "exactSource": { "$ref": "#/$defs/exactSource" },
    "qualityGate": { "$ref": "#/$defs/qualityGate" },
    "security": { "$ref": "#/$defs/security" },
    "documentation": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "examples": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "tests": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "knownLimitations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "maintenance": { "$ref": "#/$defs/maintenance" },
    "deprecation": { "$ref": "#/$defs/deprecation" }
  },
  "allOf": [
    {
      "if": { "properties": { "lifecycle": { "const": "admitted" } }, "required": ["lifecycle"] },
      "then": {
        "properties": {
          "qualityGate": {
            "properties": { "receipt": { "$ref": "#/$defs/qualityReference" }, "admissionEvidenceState": { "const": "verified" } },
            "required": ["receipt", "admissionEvidenceState"]
          },
          "documentation": { "minItems": 1 }, "examples": { "minItems": 1 }, "tests": { "minItems": 1 }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "blueprint" } }, "required": ["type"] },
      "then": { "properties": { "blueprint": { "$ref": "#/$defs/blueprint" } } },
      "else": { "properties": { "blueprint": { "type": "null" } } }
    },
    {
      "if": { "properties": { "type": { "const": "module" }, "lifecycle": { "const": "admitted" } }, "required": ["type", "lifecycle"] },
      "then": { "properties": { "dependencies": { "minItems": 2 }, "interfaces": { "minItems": 1 } } }
    }
  ],
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
    "nonEmptyStrings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "repository": { "type": "object", "additionalProperties": false, "required": ["id", "path"], "properties": { "id": { "type": "string", "minLength": 1 }, "path": { "type": "string", "minLength": 1 } } },
    "dependency": { "type": "object", "additionalProperties": false, "required": ["assetId", "type", "versionRange"], "properties": { "assetId": { "type": "string" }, "type": { "enum": ["block", "module", "blueprint"] }, "versionRange": { "type": "string", "minLength": 1 } } },
    "interface": { "type": "object", "additionalProperties": false, "required": ["id", "direction", "schema", "description"], "properties": { "id": { "type": "string", "minLength": 1 }, "direction": { "enum": ["input", "output", "bidirectional"] }, "schema": { "type": "string", "minLength": 1 }, "description": { "type": "string", "minLength": 1 } } },
    "compatibility": { "type": "object", "additionalProperties": false, "required": ["factoryCore", "runtimes", "notes"], "properties": { "factoryCore": { "type": "string", "minLength": 1 }, "runtimes": { "$ref": "#/$defs/nonEmptyStrings" }, "notes": { "type": "array", "items": { "type": "string" } } } },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["sourceType", "sourcePath", "evidence"], "properties": { "sourceType": { "const": "repository" }, "sourcePath": { "type": "string", "minLength": 1 }, "evidence": { "$ref": "#/$defs/nonEmptyStrings" } } },
    "exactSource": { "type": "object", "additionalProperties": false, "required": ["repository", "candidateSha", "version"], "properties": { "repository": { "type": "string", "minLength": 1 }, "candidateSha": { "$ref": "#/$defs/sha" }, "version": { "type": "string", "minLength": 1 } } },
    "qualityReference": { "type": "object", "additionalProperties": false, "required": ["sourceType", "taskId", "receiptId", "candidateSha"], "properties": { "sourceType": { "const": "factory-quality-gate" }, "taskId": { "type": "string", "minLength": 1 }, "receiptId": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }, "candidateSha": { "$ref": "#/$defs/sha" } } },
    "qualityGate": { "type": "object", "additionalProperties": false, "required": ["receipt", "admissionEvidenceState"], "properties": { "receipt": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/qualityReference" }] }, "admissionEvidenceState": { "enum": ["missing", "verified"] } } },
    "security": { "type": "object", "additionalProperties": false, "required": ["riskTier", "dataSensitivity", "reviewState"], "properties": { "riskTier": { "enum": ["T0", "T1", "T2", "T3", "T4"] }, "dataSensitivity": { "enum": ["public", "internal", "private", "regulated"] }, "reviewState": { "type": "string", "minLength": 1 } } },
    "maintenance": { "type": "object", "additionalProperties": false, "required": ["status", "maintainer", "lastReviewedAt"], "properties": { "status": { "enum": ["active", "maintenance", "unsupported"] }, "maintainer": { "type": "string", "minLength": 1 }, "lastReviewedAt": { "type": ["string", "null"], "format": "date-time" } } },
    "deprecation": { "type": "object", "additionalProperties": false, "required": ["replacementAssetId", "reason", "effectiveAt"], "properties": { "replacementAssetId": { "type": ["string", "null"] }, "reason": { "type": ["string", "null"] }, "effectiveAt": { "type": ["string", "null"], "format": "date-time" } } },
    "blueprint": { "type": "object", "additionalProperties": false, "required": ["appProfileDefaults", "requiredRoles", "skillPacks", "qualityPolicy", "supportedStack", "integrations", "deploymentExpectations", "extensionPoints"], "properties": { "appProfileDefaults": { "type": "object" }, "requiredRoles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["shia-core", "boris", "design-director", "gary", "quality-gate"] } }, "skillPacks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["product", "design", "engineering", "ai", "quality", "growth", "operations"] } }, "qualityPolicy": { "type": "string", "minLength": 1 }, "supportedStack": { "$ref": "#/$defs/nonEmptyStrings" }, "integrations": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }, "deploymentExpectations": { "$ref": "#/$defs/nonEmptyStrings" }, "extensionPoints": { "$ref": "#/$defs/nonEmptyStrings" } } }
  }
}
